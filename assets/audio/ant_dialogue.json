{"ant_argument":{"file":"assets/audio/ant_argument.mp3","duration":61.864,"source":[8.33,70.194],"cues":[{"t0":0.09,"t1":2.09,"speaker":"driver","text":"Who told you you could fish here?"},{"t0":2.27,"t1":3.62,"speaker":"fisherman","text":"I thought it was state property."},{"t0":4.57,"t1":5.05,"speaker":"driver","text":"STATE?!"},{"t0":5.09,"t1":5.67,"speaker":"fisherman","text":"Yeah."},{"t0":5.85,"t1":6.37,"speaker":"driver","text":"This?"},{"t0":6.4,"t1":6.89,"speaker":"fisherman","text":"Yeah."},{"t0":6.94,"t1":7.59,"speaker":"driver","text":"STATE!"},{"t0":7.66,"t1":8.12,"speaker":"fisherman","text":"Hey\u2014"},{"t0":8.32,"t1":9.65,"speaker":"driver","text":"Hit the road, dude."},{"t0":9.65,"t1":10.99,"speaker":"driver","text":"This ain't no state property."},{"t0":10.99,"t1":12.57,"speaker":"driver","text":"This is private property."},{"t0":13.09,"t1":13.41,"speaker":"fisherman","text":"Oh."},{"t0":13.41,"t1":14.25,"speaker":"driver","text":"What is your name, man?"},{"t0":14.29,"t1":15.37,"speaker":"driver","text":"I want your name."},{"t0":15.43,"t1":15.74,"speaker":"fisherman","text":"Huh?"},{"t0":15.74,"t1":16.66,"speaker":"driver","text":"So I can call down"},{"t0":16.66,"t1":18.17,"speaker":"driver","text":"and see who gave you permission."},{"t0":18.27,"t1":19.72,"speaker":"fisherman","text":"My name is State Prop."},{"t0":25.65,"t1":28.05,"text":"I ain't never heard of that before in my life.","speaker":"driver"},{"t0":28.37,"t1":31.83,"text":"And a man just called me and called Trey.","speaker":"driver"},{"t0":33.54,"t1":35.39,"text":"He said, 'Lock him up.'","speaker":"driver"},{"t0":36.775,"t1":38.39,"text":"Lock 'em up!","speaker":"driver"}],"env":[0.03,0.04,0.07,0.12,0.23,0.16,0.2,0.31,0.51,0.8,0.92,0.82,0.47,0.47,0.82,1.2,0.83,0.35,0.65,0.23,0.25,0.16,0.1,0.12,0.23,0.3,0.29,0.31,0.29,0.15,0.11,0.07,0.14,0.19,0.18,0.18,0.29,0.8,1.06,0.37,0.25,0.08,0.08,0.05,0.06,0.09,1.2,1.17,0.56,0.5,0.63,0.9,1.01,0.29,0.19,0.19,0.16,0.21,0.17,0.12,0.06,0.06,0.